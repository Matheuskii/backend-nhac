# ==============================================================================
# Variáveis de Ambiente - Nhac Backend
# ==============================================================================
# Renomeie este arquivo para .env e preencha com seus dados reais.
# O Spring Boot vai usar os valores padrão definidos no application.properties
# caso você não preencha alguma destas variáveis.
# ==============================================================================

# ---------------------------------------
# Banco de Dados (MariaDB)
# ---------------------------------------
DB_URL=jdbc:mariadb://localhost:3306/nhac_db
DB_USER=root
DB_PASS=senai2026

# ---------------------------------------
# Segurança (JWT)
# ---------------------------------------
# Chave secreta usada para assinar os tokens JWT de autenticação
JWT_SENHA=minha_chave_secreta_local_muito_segura_12345

# ---------------------------------------
# Google (Login Social)
# ---------------------------------------
CLIENT_GOOGLE_ID=google_cloud_client_id

# ---------------------------------------
# Twilio (SMS Auth)
# ---------------------------------------
TWILIO_SID=seu_twilio_sid
AUTH_TOKEN=seu_twilio_auth_token
NUMBER=numero

# ---------------------------------------
# Stripe (Pagamentos Cartão / Google Pay)
# ---------------------------------------
# Começa com sk_test_... no ambiente de sandbox
STRIPE_API_KEY=sk_test_sua_chave_secreta_stripe
# Começa com whsec_... (Pegue na aba de webhooks da Stripe)
STRIPE_WEBHOOK_SECRET=whsec_seu_segredo_de_webhook_stripe

# ---------------------------------------
# Asaas (Pagamentos PIX)
# ---------------------------------------
# Pegue no painel do Asaas em Configurações > Integrações > API
ASAAS_API_KEY=sua_chave_de_api_do_asaas
# URL do ambiente. Para produção use https://api.asaas.com/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# Um token de segurança que você mesmo inventa. 
# Configure o exato mesmo valor lá no painel de Webhooks do Asaas.
ASAAS_WEBHOOK_TOKEN=um_token_seguro_inventado_por_mim_123

# ---------------------------------------
# Brevo (E-mail Transacional)
# ---------------------------------------
BREVO_API_KEY=sua_api_key_da_brevo
BREVO_SENDER_EMAIL=noreply@nhac.com.br
BREVO_SENDER_NAME=Nhac Delivery


# ---------------------------------------
# Firebase Storage (upload de imagens de loja/produtos)
# ---------------------------------------
# Deixe NHAC_STORAGE_MOCK_MODE=true (ou remova a variável) para rodar sem credenciais reais:
# o upload só loga e devolve uma URL de placeholder, sem subir nada de verdade.
NHAC_STORAGE_MOCK_MODE=true
# Nome do bucket do Firebase Storage do projeto, ex: nhac-delivery.appspot.com
FIREBASE_STORAGE_BUCKET=
# O JSON da service account (baixado no Console do Firebase > Configurações do projeto >
# Contas de serviço > Gerar nova chave privada) codificado em Base64 numa linha só.
# Ex de como gerar localmente: base64 -w0 service-account.json
FIREBASE_CREDENTIALS_BASE64=